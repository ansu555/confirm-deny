# TrueForge — the harness. Runs the agent loop and holds every other credential.
# Local mode: npx @truefoundry/trueforge@latest
TRUEFORGE_BASE_URL=http://localhost:3000
TRUEFORGE_TOKEN=

# Model FQN, provider/model.
CONFIRM_DENY_MODEL=anthropic/claude-sonnet-4-6

# Name of the GitHub MCP connector configured in TrueForge (Settings → Connectors).
GITHUB_MCP_SERVER=github

# NOTE: there is deliberately no GitHub token and no Daytona key here.
# Both live in TrueForge, not in this app and never in the sandbox. That
# separation is the safety claim, not a configuration detail — see the README.
