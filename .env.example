# Copy to .env and fill in. .env is gitignored — keep it that way.

# ── Our app → TrueForge ──────────────────────────────────────────────
# The only credential this app holds. Everything else belongs to TrueForge.
TRUEFORGE_BASE_URL=http://localhost:3000
TRUEFORGE_TOKEN=

# Model FQN as TrueForge exposes it: <provider name>/<model name>.
CONFIRM_DENY_MODEL=google-gemini/gemini-3.1-flash-lite

# Name of the GitHub MCP connector configured in TrueForge.
GITHUB_MCP_SERVER=github

# ── The following belong to TrueForge, not to this app ───────────────
# Recorded here so one file documents the whole setup. Paste them into
# TrueForge's UI (see SETUP.md); this app never reads them.
#
# Model and MCP credentials never enter the sandbox. That separation is
# the safety claim, not a configuration detail.

# Sandbox provider — Daytona is the only one TrueForge supports.
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api

# Model provider — Google Gemini, direct.
GOOGLE_GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=

# Do NOT route through OpenRouter. It prefixes every stream with
# ": OPENROUTER PROCESSING" SSE comment lines, which crash TrueForge's
# stream parser with "Unexpected end of JSON input". Verified on every
# model tested, including a 1.0s response — it is not a slow-model
# artifact. Gemini direct emits zero comment lines.
