# Copy to .env and fill in. .env is gitignored — keep it that way.

# ── Our app → TrueForge ──────────────────────────────────────────────
# The only credential this app holds. Everything else belongs to TrueForge.
TRUEFORGE_BASE_URL=http://localhost:8790

# Empty in local mode. TrueForge boots with "Auth is disabled; browser
# login is off" — there is no token to create.
TRUEFORGE_TOKEN=

# Model FQN as TrueForge exposes it: <provider name>/<model name>.
# Dots become dashes: gemini-3.1-flash-lite → gemini-3-1-flash-lite.
# GET /api/v1/models lists what your instance actually serves.
CONFIRM_DENY_MODEL=openrouter/glm-5-3-flash

# Name of the GitHub MCP connector configured in TrueForge.
GITHUB_MCP_SERVER=github

# Raise if a turn ends as "cancelled" with no error. The other cause is a
# context_length declared smaller than the model's real window — check both.
CONFIRM_DENY_ITERATION_LIMIT=200

# ── The following belong to TrueForge, not to this app ───────────────
# Recorded here so one file documents the whole setup. Configure them in
# TrueForge (see SETUP.md); this app never reads them.
#
# Model and MCP credentials never enter the sandbox. That separation is
# the safety claim, not a configuration detail.

# Sandbox provider — Daytona is the only one TrueForge supports.
# Set a default region in the Daytona dashboard or provisioning 500s.
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api

# Model provider — whichever you registered. Both were tested.
OPENROUTER_API_KEY=
GOOGLE_GEMINI_API_KEY=
